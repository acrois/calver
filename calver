#!/usr/bin/env bash
set -eo pipefail

# =========
# calver
# =========
# Description: Utility for automatically tagging git repositories using CalVer.
# Author:      Aaron Croissette
# Created:     2023.05.10

FORMAT=
DRY_RUN=true
PUSH=false
DEFER_TAG_PUSH=false
TAG_PUSH_NEEDED=false
AUTO_VARIANT=false
BACKFILL=false
BACKFILL_DAYS=1
BACKFILL_ALL=false
BACKFILL_BASE_REF=
BACKFILL_BASE_REF_SET=false
CLEAR_BRANCH_TAGS=false
FROM_DATE=
VARIANT=
REV=0
PREFIX=
FULLVER=
SEMIVER=
VER=
SHOW=
IN_GIT=false
GIT_SHA=
BRANCH=

declare -A NEXT_REV_BY_BASE

push_tags() {
    if [ "$PUSH" = true ]; then
        if [ "$DEFER_TAG_PUSH" = true ]; then
            TAG_PUSH_NEEDED=true
        else
            git push origin -f --tags
        fi
    fi
}

flush_deferred_tag_push() {
    if [ "$PUSH" = true ] && [ "$TAG_PUSH_NEEDED" = true ]; then
        git push origin -f --tags
        TAG_PUSH_NEEDED=false
    fi
}

tag() {
    local SHA="$1"
    local TAG="$2"
    local ALLOW_MOVE="${3:-false}"
    local TAG_SHA=

    TAG_SHA="$(git rev-list -n 1 "$TAG" 2>/dev/null || true)"
    TAG_MESSAGE="CalVer tag $TAG for $SHA"

    if [ -n "$TAG_SHA" ] && [ "$TAG_SHA" = "$SHA" ]; then
        echo "Tag $TAG already points at $SHA"
        return 0
    fi

    if [ -n "$TAG_SHA" ]; then
        if [ "$ALLOW_MOVE" = true ]; then
            if [ "$DRY_RUN" = true ]; then
                echo "Move tag $TAG from $TAG_SHA to $SHA"
                return 0
            fi

            git tag -f "$TAG" "$SHA" -m "$TAG_MESSAGE"
            push_tags
            echo "Moved $TAG -> $SHA (was $TAG_SHA)"
            return 0
        fi
        echo "Tag $TAG already exists on $TAG_SHA, skipping"
        return 0
    fi

    if [ $DRY_RUN = false ]; then
        # Respect repository git config for signing/annotation behavior.
        git tag "$TAG" "$SHA" -m "$TAG_MESSAGE"

        push_tags

        echo "Tagged $TAG -> $SHA"
    else
        echo "Tag $TAG -> $SHA"
    fi
}

clear_tags_for_range() {
    local RANGE="$1"
    local TAG=
    local TAG_SHA=
    local SHA_IN_RANGE=
    local CLEAR_COUNT=0

    declare -A COMMITS_IN_RANGE
    while IFS= read -r SHA_IN_RANGE; do
        [ -n "$SHA_IN_RANGE" ] && COMMITS_IN_RANGE["$SHA_IN_RANGE"]=1
    done < <(git rev-list "$RANGE")

    while IFS= read -r TAG; do
        [ -z "$TAG" ] && continue
        TAG_SHA="$(git rev-list -n 1 "$TAG" 2>/dev/null || true)"
        [ -z "$TAG_SHA" ] && continue

        if [ -n "${COMMITS_IN_RANGE[$TAG_SHA]+x}" ]; then
            CLEAR_COUNT=$((CLEAR_COUNT + 1))
            if [ "$DRY_RUN" = true ]; then
                echo "Clear tag $TAG (points at $TAG_SHA)"
            else
                git tag -d "$TAG" >/dev/null
                if [ "$PUSH" = true ]; then
                    git push origin ":refs/tags/$TAG" >/dev/null
                fi
                echo "Cleared tag $TAG (was $TAG_SHA)"
            fi
        fi
    done < <(git tag -l)

    if [ "$CLEAR_COUNT" -eq 0 ] && [ -z "$SHOW" ]; then
        echo "No tags matched clear range."
    fi
}

format_variant() {
    local __resultvar=
    local myresult=
    local VARIANT=
    local REVISION=

    while [ "$1" != "" ]; do
        PARAM="${1%%=*}"
        VALUE="${1#*=}"
        case $PARAM in
            --o)
                __resultvar=$VALUE
                ;;
            --i)
                myresult=$VALUE
                ;;
            --v)
                VARIANT=$VALUE
                ;;
            --r)
                REVISION=$VALUE
                ;;
            *)
                echo "ERROR: unknown parameter \"$PARAM\""
                exit 1
                ;;
        esac
        shift
    done

    if [ -n "$VARIANT" ]; then
        myresult="$myresult-$VARIANT"
    fi

    if [ -n "$REVISION" ]; then
        myresult="$myresult.$REVISION"
    fi

    if [[ "$__resultvar" ]]; then
        eval "$__resultvar=\"\$myresult\""
    else
        echo "$myresult"
    fi
}

ver_for_date() {
    local __resultvar=
    local FORMAT=
    local FROM_DATE='now'

    while [ "$1" != "" ]; do
        PARAM="${1%%=*}"
        VALUE="${1#*=}"
        case $PARAM in
            --o)
                __resultvar=$VALUE
                ;;
            --fmt)
                FORMAT=$VALUE
                ;;
            --d)
                FROM_DATE=$VALUE
                ;;
            *)
                echo "ERROR: unknown parameter \"$PARAM\""
                exit 1
                ;;
        esac
        shift
    done

    local myresult=

    if [ -z "$FORMAT" ]; then
        # Fix for zero-padding the %u (day of week)
        myresult="$(printf "%s.%02d" "$(date +%Y.%V -d "$FROM_DATE")" "$(date +%u -d "$FROM_DATE")")"
    else
        myresult="$(date +"$FORMAT" -d "$FROM_DATE")"
    fi

    if [[ "$__resultvar" ]]; then
        eval "$__resultvar=\"\$myresult\""
    else
        echo "$myresult"
    fi
}

is_git_repo() {
    git rev-parse --is-inside-work-tree >/dev/null 2>&1
}

commit_timestamp() {
    local SHA="$1"
    git show -s --format=%cI "$SHA"
}

current_branch() {
    git branch --show-current 2>/dev/null || true
}

resolve_auto_variant() {
    local BRANCH_NAME="$1"
    if [[ "$BRANCH_NAME" =~ ^(trunk|main|master)$ ]]; then
        echo -n ""
    elif [ -z "$BRANCH_NAME" ]; then
        echo -n "detached"
    else
        echo -n "$BRANCH_NAME"
    fi
}

detect_primary_branch() {
    local REMOTE_HEAD=
    REMOTE_HEAD="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
    if [ -n "$REMOTE_HEAD" ]; then
        echo "${REMOTE_HEAD#origin/}"
        return 0
    fi

    for CANDIDATE in trunk main master; do
        if git show-ref --verify --quiet "refs/heads/$CANDIDATE" || git show-ref --verify --quiet "refs/remotes/origin/$CANDIDATE"; then
            echo "$CANDIDATE"
            return 0
        fi
    done

    return 1
}

resolve_ref_for_backfill() {
    local INPUT_REF="$1"
    if git rev-parse --verify "$INPUT_REF" >/dev/null 2>&1; then
        echo "$INPUT_REF"
        return 0
    fi

    if git rev-parse --verify "origin/$INPUT_REF" >/dev/null 2>&1; then
        echo "origin/$INPUT_REF"
        return 0
    fi

    if git rev-parse --verify "refs/remotes/origin/$INPUT_REF" >/dev/null 2>&1; then
        echo "refs/remotes/origin/$INPUT_REF"
        return 0
    fi

    return 1
}

extract_revision() {
    local TAG="$1"
    if [[ "$TAG" =~ \.([0-9]+)$ ]]; then
        echo "${BASH_REMATCH[1]}"
    fi
}

revision_tag_for_commit() {
    local BASE="$1"
    local SHA="$2"
    local TAG=
    local TAG_SHA=

    while IFS= read -r TAG; do
        [ -z "$TAG" ] && continue
        TAG_SHA="$(git rev-list -n 1 "$TAG" 2>/dev/null || true)"
        if [ "$TAG_SHA" = "$SHA" ]; then
            echo "$TAG"
            return 0
        fi
    done < <(git tag -l --sort=version:refname "$BASE.*" 2>/dev/null)

    return 1
}

next_revision_for_base() {
    local BASE="$1"
    local TAG=
    local REVISION=
    local MAX_REV=-1

    if [ -n "${NEXT_REV_BY_BASE[$BASE]+x}" ]; then
        echo "${NEXT_REV_BY_BASE[$BASE]}"
        return 0
    fi

    while IFS= read -r TAG; do
        [ -z "$TAG" ] && continue
        REVISION="$(extract_revision "$TAG")"
        if [ -n "$REVISION" ] && [ "$REVISION" -gt "$MAX_REV" ]; then
            MAX_REV="$REVISION"
        fi
    done < <(git tag -l --sort=version:refname "$BASE.*" 2>/dev/null)

    NEXT_REV_BY_BASE["$BASE"]="$((MAX_REV + 1))"
    echo "${NEXT_REV_BY_BASE[$BASE]}"
}

reserve_next_revision() {
    local BASE="$1"
    local NEXT="$2"
    NEXT_REV_BY_BASE["$BASE"]="$((NEXT + 1))"
}

build_version_for_commit() {
    local SHA="$1"
    local VERSION=
    local BASE=
    local FOUND_TAG=
    local FOUND_REV=
    local COMMIT_DATE=

    COMMIT_DATE="$(commit_timestamp "$SHA")"
    ver_for_date --o='VERSION' --fmt="$FORMAT" --d="$COMMIT_DATE"

    if [ -n "$PREFIX" ]; then
        VERSION="$PREFIX/$VERSION"
    fi

    if [ -n "$VARIANT" ]; then
        format_variant --o='BASE' --i="$VERSION" --v="$VARIANT"
    else
        BASE="$VERSION"
    fi

    FOUND_TAG="$(revision_tag_for_commit "$BASE" "$SHA" || true)"
    if [ -n "$FOUND_TAG" ]; then
        FOUND_REV="$(extract_revision "$FOUND_TAG")"
        if [ -n "$FOUND_REV" ]; then
            REV="$FOUND_REV"
            reserve_next_revision "$BASE" "$REV"
        fi
    else
        REV="$(next_revision_for_base "$BASE")"
        reserve_next_revision "$BASE" "$REV"
    fi

    format_variant --o='FULLVER' --i="$VERSION" --v="$VARIANT" --r="$REV"
    VER="$VERSION"
    SEMIVER="${BASE:-$VERSION}"
}

tag_commit() {
    local SHA="$1"
    local BASE="$2"
    local REVISION_TAG="$3"

    # Base tag should follow the newest commit for this calendar/variant stream.
    tag "$SHA" "$BASE" true
    # Revision tags are immutable once assigned.
    tag "$SHA" "$REVISION_TAG" false
}

process_backfill() {
    local HEAD_SHA="$1"
    local HEAD_TS=
    local SINCE_TS=
    local RANGE=
    local BASE_SHA=
    local EFFECTIVE_BASE_REF=
    local RESOLVED_BASE_REF=
    local SHA=
    local FOUND=0
    local PREVIOUS_DEFER_TAG_PUSH="$DEFER_TAG_PUSH"

    RANGE="$HEAD_SHA"
    DEFER_TAG_PUSH=true
    TAG_PUSH_NEEDED=false
    EFFECTIVE_BASE_REF="$BACKFILL_BASE_REF"
    if [ "$BACKFILL_BASE_REF_SET" = true ] && [ -z "$EFFECTIVE_BASE_REF" ]; then
        EFFECTIVE_BASE_REF="$(detect_primary_branch || true)"
        if [ -z "$EFFECTIVE_BASE_REF" ]; then
            echo "Backfill base ref was set empty, but primary branch could not be detected."
            exit 1
        fi
        if [ -z "$SHOW" ]; then
            echo "Backfill base ref was empty; defaulting to primary branch $EFFECTIVE_BASE_REF"
        fi
    fi

    if [ -n "$EFFECTIVE_BASE_REF" ]; then
        RESOLVED_BASE_REF="$(resolve_ref_for_backfill "$EFFECTIVE_BASE_REF" || true)"
        if [ -z "$RESOLVED_BASE_REF" ]; then
            echo "Backfill base ref '$EFFECTIVE_BASE_REF' was not found."
            exit 1
        fi
        BASE_SHA="$(git merge-base "$HEAD_SHA" "$RESOLVED_BASE_REF" 2>/dev/null || true)"
        if [ -n "$BASE_SHA" ]; then
            RANGE="$BASE_SHA..$HEAD_SHA"
            if [ -z "$SHOW" ]; then
                echo "Backfill limited to commits after branch point $BASE_SHA against $RESOLVED_BASE_REF"
            fi
        fi
    fi

    if [ "$CLEAR_BRANCH_TAGS" = true ]; then
        if [ -z "$SHOW" ]; then
            echo "Clearing tags for range $RANGE"
        fi
        clear_tags_for_range "$RANGE"
    fi

    if [ "$BACKFILL_ALL" = true ]; then
        if [ -z "$SHOW" ]; then
            echo "Backfilling entire commit history from $HEAD_SHA"
        fi
        while IFS= read -r SHA; do
            [ -z "$SHA" ] && continue
            FOUND=1
            build_version_for_commit "$SHA"
            if [ -z "$SHOW" ]; then
                echo "Commit: $SHA"
                echo "Calendar: $VER"
                [ -n "$VARIANT" ] && echo "Variant: $SEMIVER"
                echo "Revision: $FULLVER"
            fi
            tag_commit "$SHA" "${SEMIVER:-$VER}" "$FULLVER"
        done < <(git rev-list --reverse "$RANGE")
    else
        HEAD_TS="$(commit_timestamp "$HEAD_SHA")"
        SINCE_TS="$(date -d "$HEAD_TS -$BACKFILL_DAYS day" --iso-8601=seconds)"

        if [ -z "$SHOW" ]; then
            echo "Backfilling commits since $SINCE_TS"
        fi

        while IFS= read -r SHA; do
            [ -z "$SHA" ] && continue
            FOUND=1
            build_version_for_commit "$SHA"
            if [ -z "$SHOW" ]; then
                echo "Commit: $SHA"
                echo "Calendar: $VER"
                [ -n "$VARIANT" ] && echo "Variant: $SEMIVER"
                echo "Revision: $FULLVER"
            fi
            tag_commit "$SHA" "${SEMIVER:-$VER}" "$FULLVER"
        done < <(git rev-list --reverse --since="$SINCE_TS" "$RANGE")
    fi

    if [ "$FOUND" -eq 0 ]; then
        # Fallback for edge cases where rev-list returns no commits.
        build_version_for_commit "$HEAD_SHA"
        tag_commit "$HEAD_SHA" "${SEMIVER:-$VER}" "$FULLVER"
    fi

    flush_deferred_tag_push
    DEFER_TAG_PUSH="$PREVIOUS_DEFER_TAG_PUSH"
}

usage() {
    # Substitute some defaults for useful help dialog integration...
    FROM_DATE='2023-05-10'
    VARIANT='dev'
    REV=10
    FORMAT=''

    # Generate some example versions based on the date
    ver_for_date --o='VER' --d=$FROM_DATE
    format_variant --o='FULLVER' --i=$VER --v=$VARIANT --r=$REV
    format_variant --o='SEMIVER' --i=$VER --v=$VARIANT

    echo -e "\nUsage:\n" \
        "\t$0 --version=\"$VER\" --variant=\"$VARIANT\" --revision=\"$REV\"\n" \
        "\t$0 --date=\"$FROM_DATE\" --variant=\"$VARIANT\" --revision=\"$REV\"\n" \
        "\nOutput tags:\n" \
        "\tRevision:  $FULLVER\n" \
        "\tVariant:   $SEMIVER\n" \
        "\tCalendar:  $VER\n" \
        "\nFlags:\n" \
        "\t--format            - date format, defaults to %Y.%V.%u according to \`man date\`\n" \
        "\t--version           - version to release\n" \
        "\t--date              - date to base version off of\n" \
        "\t--auto              - automatically creates variants based on branch name.\n" \
        "\t                        if on main, master, or trunk it is \"\".\n" \
        "\t                        if there is no branch, it is \"detached\".\n" \
        "\t--variant           - adds a variant tag e.g $LESSVER\n" \
        "\t--revision          - adds a revision incrementer after the variant e.g $FULLVER\n" \
        "\t--prefix            - adds a prefix in front of the version e.g node/$FULLVER\n" \
        "\t--backfill          - tags untagged commits from at least one day before HEAD\n" \
        "\t--backfill-days     - days to backfill from HEAD commit timestamp (default: 1)\n" \
        "\t--backfill-all      - backfills tags for the entire reachable history from HEAD\n" \
        "\t--backfill-base-ref - limit backfill to commits after merge-base with this ref (empty: auto primary)\n" \
        "\t--clear-branch-tags - clear tags that point at commits in the backfill range\n" \
        "\t--apply             - disable dry run and do it for real\n" \
        "\t--push              - push after applying\n" \
        "\t--show              - show version tag (values: calendar, variant, revision)\n" \
        "\t--v                 - verbose output (\`set -x\`)\n" \
        "\t--help              - prints this useful information\n" >&2
    exit 1
}

while [ "$1" != "" ]; do
    PARAM="${1%%=*}"
    VALUE="${1#*=}"
    case $PARAM in
        --version)
            VER=$VALUE
            ;;
        --prefix)
            PREFIX=$VALUE
            ;;
        --format)
            FORMAT=$VALUE
            ;;
        --date)
            FROM_DATE=$VALUE
            ;;
        --revision)
            REV=$VALUE
            ;;
        --backfill)
            BACKFILL=true
            ;;
        --backfill-days)
            BACKFILL=true
            BACKFILL_DAYS=$VALUE
            ;;
        --backfill-all)
            BACKFILL=true
            BACKFILL_ALL=true
            ;;
        --backfill-base-ref)
            BACKFILL_BASE_REF_SET=true
            BACKFILL_BASE_REF=$VALUE
            ;;
        --clear-branch-tags)
            CLEAR_BRANCH_TAGS=true
            ;;
        --apply)
            DRY_RUN=false
            ;;
        --push)
            PUSH=true
            ;;
        --variant)
            VARIANT=$VALUE
            ;;
        --auto)
            AUTO_VARIANT=true
            ;;
        --show)
            SHOW=$VALUE
            ;;
        --v)
            set -x
            ;;
        --help)
            usage
            ;;
        *)
            echo "ERROR: unknown parameter \"$PARAM\""
            exit 1
            ;;
    esac
    shift
done

# check to see if this file is being run or sourced from another script
_is_sourced() {
	# https://unix.stackexchange.com/a/215279
	[ "${#FUNCNAME[@]}" -ge 2 ] \
		&& [ "${FUNCNAME[0]}" = '_is_sourced' ] \
		&& [ "${FUNCNAME[1]}" = 'source' ]
}

_main() {
    local RESOLVED_DATE="$FROM_DATE"
    local VARLOOK=
    local CURR_TAG=
    local CURR_TAG_SHA=
    local CURR_REV=

    if is_git_repo; then
        IN_GIT=true
    fi

    if [ "$IN_GIT" = false ]; then
        if [ "$AUTO_VARIANT" = true ]; then
            VARIANT='detached'
        fi
        if [ -z "$VER" ]; then
            ver_for_date --o='VER' --fmt="$FORMAT" --d="$RESOLVED_DATE"
        fi
        if [ -n "$VARIANT" ]; then
            format_variant --o='SEMIVER' --i="$VER" --v="$VARIANT"
        fi
        format_variant --o='FULLVER' --i="$VER" --v="$VARIANT" --r="$REV"
        case $SHOW in
            'calendar') echo -n "$VER"; exit ;;
            'variant') echo -n "${SEMIVER:-$VER}"; exit ;;
            'revision') echo -n "$FULLVER"; exit ;;
        esac
        echo "Not in a git repository. Use --show, --date, or --version for non-git usage."
        exit 1
    fi

    if [ -z "$SHOW" ]; then
        echo "Fetching metadata from git origin..."
    fi
    git fetch --all --tags 2>/dev/null || true
    GIT_SHA="$(git rev-parse HEAD)"
    BRANCH="$(current_branch)"

    if [ "$AUTO_VARIANT" = true ]; then
        VARIANT="$(resolve_auto_variant "$BRANCH")"
    fi

    if [ -z "$VER" ]; then
        if [ -z "$RESOLVED_DATE" ]; then
            RESOLVED_DATE="$(commit_timestamp "$GIT_SHA")"
        fi
        ver_for_date --o='VER' --fmt="$FORMAT" --d="$RESOLVED_DATE"
    fi

    if [ -n "$PREFIX" ]; then
        VER="$PREFIX/$VER"
    fi

    if [ -z "$VER" ]; then
        echo "No version detected, aborting."
        exit 1
    fi

    if [ -z "$SHOW" ]; then
        echo "SHA: $GIT_SHA"
        echo "Branch: $BRANCH"
    fi

    if [ -z "$SHOW" ]; then
        echo "Calendar: $VER"
        if [ -n "$VARIANT" ]; then
            echo "Variant set: $VARIANT"
        fi
    fi

    if [ -n "$VARIANT" ]; then
        format_variant --o='SEMIVER' --i="$VER" --v="$VARIANT"
        if [ -z "$SHOW" ]; then
            echo "Variant: $SEMIVER"
        fi
    fi

    VARLOOK=${SEMIVER:-$VER}
    CURR_TAG="$(git tag -l --sort=-version:refname "$VARLOOK.*" | head -n 1 2>/dev/null)"

    if [ -n "$CURR_TAG" ]; then
        CURR_TAG_SHA="$(git rev-list -n 1 "$CURR_TAG")"
        CURR_REV="$(extract_revision "$CURR_TAG")"

        if [ -z "$CURR_REV" ]; then
            CURR_REV=0
        fi

        if [[ "$GIT_SHA" != "$CURR_TAG_SHA" ]]; then
            REV="$((CURR_REV + 1))"

            if [ -z "$SHOW" ]; then
                echo "Existing revision $CURR_REV, incrementing ours to $REV"
            fi
        elif [ -z "$SHOW" ]; then
            REV="$((CURR_REV + 0))"
            echo "Existing tag $CURR_TAG is our commit, using $REV"
        fi
    fi

    format_variant --o='FULLVER' --i="$VER" --v="$VARIANT" --r="$REV"

    if [ -z "$SHOW" ]; then
        echo "Revision: $FULLVER"
    fi

    case $SHOW in
        'calendar')
            echo -n "$VER"
            exit
            ;;
        'variant')
            echo -n "${SEMIVER:-$VER}"
            exit
            ;;
        'revision')
            echo -n "$FULLVER"
            exit
            ;;
        *)  ;;
    esac

    if [ "$BACKFILL" = true ]; then
        process_backfill "$GIT_SHA"
        exit 0
    fi

    if [ "$DRY_RUN" = true ]; then
        echo "================================="
        echo "DRY RUN - NOTHING WILL BE CHANGED"
        echo "================================="
    fi

    tag_commit "$GIT_SHA" "${SEMIVER:-$VER}" "$FULLVER"
}

# If we are sourced from elsewhere, don't perform any further actions
if ! _is_sourced; then
	_main "$@"
fi
